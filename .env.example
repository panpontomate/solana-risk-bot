# Copia este archivo como .env y rellena el token que te dio @BotFather.
# El archivo .env no se sube a GitHub (está en .gitignore): el token es secreto.
TELEGRAM_BOT_TOKEN=

# Opcional: tu propia URL de RPC (Helius tiene plan gratuito). Sin ella usa RPC públicos gratuitos.
SOLANA_RPC_URL=

# Opcional: minutos entre revisiones de lo vigilado, y máximo de vigilancias por chat
WATCH_INTERVAL_MIN=15
MAX_WATCHES=10
